                <div class="clearfix filters-container m-t-10" style="margin-top: 0">
                    <div class="row">
                        <div class="col col-md-12 text-right">
                            <form class="woocommerce-ordering" method="get">
                                <select name="orderby" style="width:auto" class="orderby" aria-label="Shop order" asp-items="options" onchange="submitPriceFilter(this.value)">
