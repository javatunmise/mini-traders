                    <ul class="page-numbers">
                        <li><span aria-current="page" class="page-numbers current">1</span></li>
                        <li><a class="page-numbers" href="./page/2/">2</a></li>
                        <li><a class="next page-numbers" href="./page/2/"></a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>


@section sliderScript {

    <script type="text/javascript">
        $(document).ready(function () {
            $(".js-range-slider").ionRangeSlider({
                type: "double",
                min: @Model.PriceRange.Min,
                max: @Model.PriceRange.Max,
                from: @selectedMinPrice,
                to: @selectedMaxPrice,
                grid: false,
                hide_min_max: true,
                hide_from_to: true,
                skin: "sharp",
                onFinish: function (data) {
                    $('#min_price').val(data.from);
                    $('#max_price').val(data.to);
                }
            });

        });
    </script>

    <script type="text/javascript">
        $('#location').change(function () {
            var locId = $(this).val();
            if (locId == 0) {
                hideSubLocations();
            }
            else {
                getSubLocs(locId);
            }
        });

        function getSubLocs(id) {
            showHideSpinner(true);
            fetch('/api/data/sublocations/' + id)
                .then(response => response.json())
                .then(data => loadSelect(data))
                .catch(function () {
                    showHideSpinner(false);
                });
        }

        function loadSelect(data) {
            $('#sub_location').empty();
            $('#sub_location').append($("<option />").val(0).text("Any Location"));
            $.each(data, function (i, item) {
                $('#sub_location').append($("<option />").val(item.id).text(item.name));
            });

            showHideSpinner(false);
        }

        function showHideSpinner(show) {
            if (show) {
                $('#spinner').show();
            }
            else {
                $('#spinner').hide();
            }
        }

        function hideSubLocations() {
            $('#sub_location_container').hide();
        }


        function submitPriceFilter(value) {
            $('#hd_order_by').val(value);
            $('#category-searchform').submit();
        }

    </script>
}