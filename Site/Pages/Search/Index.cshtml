@page
@using site.ViewComponents;
@using site.Data;
@using site.Helpers;

@inject site.Data.ISiteContentProvider  _siteContentProvider;
@model site.Pages.Search.IndexModel

@{
    var options = new SelectList(new[] {
        new KeyValuePair<string, string>("date", "Sort by latest"),
        new KeyValuePair<string, string>("price", "Sort by price: low to high"),
        new KeyValuePair<string, string>("price-desc", "Sort by price: high to low"),
    }, "Key", "Value", Model.Query.OrderBy);

    ViewData["Title"] = "Search";
    var selectedMaxPrice = Model.Query.MaxPrice > 0 ? Math.Min(Model.Query.MaxPrice, Model.PriceRange.Max) : Model.PriceRange.Max;
    var selectedMinPrice = Model.Query.MinPrice >= Model.PriceRange.Min ? Math.Min(Model.Query.MinPrice, Model.PriceRange.Max) : Model.PriceRange.Min;
}


<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item">Search results for: <strong>@Model.Query?.SearchText</strong></li>
    </ol>
}

<link href="~/css/site-products-list.css" rel="stylesheet" />

<div class="body-content outer-top-ts">
    <div class="container">
        <div class="row">
            <div class="col-sm-3 col-xs-12 klb-sidebar">
                <form role="search" method="get" id="category-searchform" action="/search">
                    <input type="hidden" name="orderby" id="hd_order_by" value="date" />

                    <div class="sidebar-widget woocommerce widget_product_search">
                        <div class="control-group">
                            <input type="text" class="search-field" value="" name="q" id="q" placeholder="Search">
                            <button type="submit" class="search-button" />
                        </div>
                    </div>

                    <div class="sidebar-widget widget_price_filter">
                        <h3 class="section-title" style="margin-bottom: 0">Filter by location</h3>

                        <select name="location" id="location" class="form-control">
                            <option value="0">Any Locations</option>

                            @foreach (var loc in Model.Locations)
                            {
                                if (loc.Id.ToString() == Model.Query.LocationId)
                                {
                                    <option value="@loc.Id" selected>@loc.Name</option>
                                }
                                else
                                {
                                    <option value="@loc.Id">@loc.Name</option>
                                }
                            }
                        </select>
                        <div style="padding-top: 15px;" id="sub_location_container">
                            <select name="sub_location" id="sub_location" class="form-control">
                                <option value="0">Any Locations</option>
                                @foreach (var loc in Model.SubLocations)
                                {
                                    if (loc.Id.ToString() == Model.Query.SubLocationId)
                                    {
                                        <option value="@loc.Id" selected>@loc.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <br />
                        <div class="price_slider_amount">
                            <img id="spinner" src="~/images/spinner.jpg" style="height:45px; display: none" />
                            <button type="submit" class="button">Filter</button>
                        </div>

                    </div>


                    <div class="sidebar-widget widget_price_filter">
                        <h3 class="section-title">Filter by price</h3>
                        <div class="price_slider_wrapper">
                            <div>
                                <input type="text" class="js-range-slider" value="@Request.Query["my_range"]" style="visibility: hidden" />
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-5">
                                    <input class="form-control" name="min_price" id="min_price" type="number" max="@Model.PriceRange.Max" value="@selectedMinPrice" />
                                </div>
                                <div class="form-group col-md-1 text-center">
                                    <span> _ </span>
                                </div>
                                <div class="form-group col-md-6">
                                    <input class="form-control" name="max_price" id="max_price" type="number" max="@Model.PriceRange.Max" value="@selectedMaxPrice" />
                                </div>
                            </div>
                            <br />
                            <div class="price_slider_amount">
                                <button type="submit" class="button">Filter</button>
                            </div>
                        </div>
                    </div>

                </form>

                <div class="sidebar-widget woocommerce widget_product_categories">
                    <h3 class="section-title">Product categories</h3>
                    <ul class="product-categories">
                        @foreach (var cat in Model.Categories)
                        {
                            <li class="cat-item cat-item-28"><a href="@PathUtil.GetCategoryPath(cat)">@cat.Name</a></li>
                        }
                    </ul>
                </div>
