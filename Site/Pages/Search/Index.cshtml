                                <div class="row">
                                    @foreach (var p in Model.Products)
                                    {
                                    <div class="a-product col-sm-6 col-md-4 col-lg-4">
                                        <div class="overlay">
                                            <a class="vendor-name" href="~/sellers/@p.StoreId-@p.StoreName">@p.StoreName</a>
                                        </div>
                                        <div class="image">
                                            <a href="~/products/@($"{p.Id}-{p.Name}")">
