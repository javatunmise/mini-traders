@model site.ViewComponents.ProductsGrid.ProductsGridInfo

@{
    string title = Model?.Title ?? "Featured Products";
    var categories = new List<site.Data.Category>
    {
        new site.Data.Category { Name = "Fashion & Clothing" },
        new site.Data.Category { Name = "Health & Beauty" },
        new site.Data.Category { Name = "Grocery & Kitchen Items" },
    };

    var counter = 0;
    var numbers = new []{ "one", "two", "three" };
}


<div class="latest-products" style="display:block">
    <div class="latest-products-header row">
        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12"><h2 style="color:#333" class="title">Latest Products</h2></div>
        <div class="col-lg-7 col-md-6 col-sm-10 col-xs-10" style="padding-top: 15px">
            <div class="tabs">
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                    @foreach (var category in categories)
                    {
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(counter == 0 ? "active" : "")" id="pills-home-tab" data-toggle="pill" href="#@numbers[counter]" role="tab" aria-controls="pills-home" aria-selected="true">@category.Name</a>
                        </li>

                        counter++;
                        if (counter == 3)
                        {
                            break;
                        }
                    }
                </ul>
            </div>
        </div>
        <div class="col-lg-1 col-md-2 col-sm-2 col-xs-2">
            <div class="owl-nav">
                <button role="presentation" class="owl-prev">&lt;</button>
                <button role="presentation" class="owl-next">&gt;</button>
            </div>
        </div>
    </div>
    <div class="latest-products-inner carousel-wrapper">
        <div class="tab-content">
            <div class="tab-pane show active" id="one">
                <div class="owl-carousel one">

                    @foreach (var product in Enumerable.Range(0, 5).Select(c => new site.Data.Category { }))
                    {
                        <div class="item item-carousel" style="">
                            <div class="image">
                                <a href="/product/the-crash-bad-instant-folding-long-twin-bed-3/"><img src="~/images/products/product-@(counter % 3 + 1).jpg" alt="The Crash Bad Instant Folding long Twin Bed"></a>
                            </div>

                            <div class="title"><a href="/products/123-same products">The Crash Bad Instant Folding long Twin Bed</a></div>
                            <div class="rating">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="fa fa-star"></i>
                                }
                            </div>
                            <div class="price">
                                <span class="price-before">N120.00</span>
                                <span class="price-current">N100.00</span>
                            </div>
                        </div>

                        counter++;
                    }
                </div>
            </div>

            <div class="tab-pane" id="two">
                <div class="owl-carousel two">

                    @foreach (var product in Enumerable.Range(0, 5).Select(c => new site.Data.Category { }))
                    {
                        <div class="item item-carousel" style="">
                            <div class="image">
                                <a href="/product/the-crash-bad-instant-folding-long-twin-bed-3/"><img src="~/images/products/product-@(counter % 4 + 1).jpg" alt="The Crash Bad Instant Folding long Twin Bed"></a>
                            </div>

                            <div class="title"><a href="/products/123-same products">The Crash Bad Instant Folding long Twin Bed</a></div>
                            <div class="rating">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="fa fa-star"></i>
                                }
                            </div>
                            <div class="price">
                                <span class="price-before">N120.00</span>
                                <span class="price-current">N100.00</span>
                            </div>
                        </div>

                        counter++;
                    }
                </div>
            </div>

            <div class="tab-pane" id="three">
                <div class="owl-carousel three">

                    @foreach (var product in Enumerable.Range(0, 5).Select(c => new site.Data.Category { }))
                    {
                        <div class="item item-carousel" style="">
                            <div class="image">
                                <a href="/product/the-crash-bad-instant-folding-long-twin-bed-3/"><img src="~/images/products/product-@(counter % 2 + 2).jpg" alt="The Crash Bad Instant Folding long Twin Bed"></a>
                            </div>

                            <div class="title"><a href="/products/123-same products">The Crash Bad Instant Folding long Twin Bed</a></div>
                            <div class="rating">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="fa fa-star"></i>
                                }
                            </div>
                            <div class="price">
                                <span class="price-before">N120.00</span>
                                <span class="price-current">N100.00</span>
                            </div>
                        </div>

                        counter++;
                    }
                </div>
            </div>

        </div>

    </div>
</div>

