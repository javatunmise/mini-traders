@model site.ViewComponents.GroupsGrid.GroupsGridInfo;

@{ 
    string title = Model.Title;
    string[] items = new[]
    {
        "Meat & Fish",
        "Grains & Bread",
        "Oil & Fat",
        "Dairy & Eggs",
        "Produce",
        "Tinned & Dried Produce",
        "Condiments"
    };

    int pageSize = 2;
    int pageIndex = 0;
    int currentPage = 0;
    int count = items.Length;
}

<div class="top-slr groups-grid-single">
    <div class="sec-title">
        <h5>@title</h5>
    </div>
    <div class="slr-slider owl-carousel">
        @while (currentPage < count)
        {
            var columnItems = items.Skip(currentPage).Take(pageSize);
            <div class="slr-items">
                @foreach (var item in columnItems)
                {
                <div class="slr-box d-flex">
                    <div class="slr-img">
                        <a href="#"><img src="images/sbar-6.png" style="height: 85px; width: 85px" alt=""></a>
                    </div>
                    <div class="slr-content">
                        <p class="gh-title"><a href="">@item</a></p>
                    </div>
                </div>
                }
            </div>

            currentPage = pageIndex * pageSize + pageSize;
            pageIndex++;
        }
    </div>
</div>
