@model site.ViewComponents.ProductsGrid_FlashDeals.FlashDealInfo

@{   
    var isVisible = Model.FlashDeal != null && Model.FlashDealProducts.Any();
    var timeLeft = Model.TimeLeft();
}


<div class="container @(isVisible ? "" : "hide")">
    <div class="home-flash-deals">
        <div class="home-flash-deals-header row">
            <div class="col-lg-2 col-md-4 col-sm-12 col-xs-12"><h2 style="color:#333" class="title">Flash Deals</h2></div>
            <div class="col-lg-8 col-md-6 col-sm-10 col-xs-9" style="padding-top: 15px; height:65px">
                <div class="box-timer countdown" data-Date='2020/09/30 13:53:43'>
                    
                    <div class="running">
                        <timer>
                            <div class="timer-grid" data-countdown="@Model.FlashDeal.EndDate">
                                <div class="box-time-date">
                                    <span class="time-num time-day days">@timeLeft.Days</span> days
                                </div>
                                <div class="box-time-date">
                                    <span class="time-num hours">@timeLeft.Hours</span> hrs
                                </div>
                                <div class="box-time-date">
                                    <span class="time-num minutes">@timeLeft.Minutes</span>mins
                                </div>
                                <div class="box-time-date">
                                    <span class="time-num seconds">@timeLeft.Seconds</span>secs
                                </div>
                            </div>
                        </timer>

                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-3">
                <div class="owl-nav">
                    <button role="presentation" class="owl-prev">&lt;</button>
                    <button role="presentation" class="owl-next">&gt;</button>
                </div>
            </div>
        </div>

        <div class="carousel-wrapper">
            <div class="owl-carousel two">
                @foreach (var product in Model.FlashDealProducts)
                {
                    @await Html.PartialAsync("~/Pages/Shared/TempViews/_GridProductView.cshtml", product)
                }
            </div>
        </div>

    </div>
</div>

