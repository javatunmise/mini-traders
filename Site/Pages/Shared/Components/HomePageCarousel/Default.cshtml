    <div id="carouselExampleControls" class="carousel slide h-100" data-ride="carousel">
        <div class="carousel-inner h-100">
            @{
                string[] banners = new string[] { "confort.png", "few second.png" };
            }

            @foreach (var banner in banners.Select((b, index) => new { filename = b, index }))
            {
                <div class="carousel-item h-100 @(banner.index == 0 ? "active" : "")">
                    <img class="d-block w-100 h-100" src="~/images/banners/@banner.filename" alt="First slide">
                </div>
            }
        </div>
        <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>


