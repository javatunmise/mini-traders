@model IEnumerable<site.Data.Carousel>

@{
    var banners = Model;
}

<div id="carouselExampleControls" class="carousel slide h-100" data-ride="carousel">
    <div class="carousel-inner h-100">
        @foreach (var banner in banners.Select((b, index) => new { filename = b.ImageUrl, index, b.DestinationUrl }))
        {
            <div class="carousel-item h-100 @(banner.index == 0 ? "active" : "")">
                <a href="@banner.DestinationUrl">
                    <img class="d-block w-100 h-100" src="@Url.Content("~/"+banner.filename)" alt="First slide">
                </a>
            </div>
        }
    </div>

    <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>
</div>


