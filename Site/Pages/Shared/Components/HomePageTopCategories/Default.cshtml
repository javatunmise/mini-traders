@model IEnumerable<site.Data.Category>

@{
    var icons = new string[]
    {
        "life-ring",
        "desktop",
        "diamond",
        "camera",
        "cutlery",
        "balance-scale",
        "female",
        "soccer-ball-o",
        "book",
        "cab",
        "",
        "",
        "",
        "",
        "",
            };

    var counter = 0;
}

<div class="featured-categories">
    @*<h2 style="color:#333">Top Categories</h2>*@
    <div class="owl-nav">
        <button role="presentation" class="owl-prev">&lt;</button>
        <button role="presentation" class="owl-next">&gt;</button>
    </div>
    <div class="featured-categories-inner">
        <div class="owl-carousel">

            @foreach (var category in Model)
            {
                <div class="item" style="width: 129px; display: inline-block">

                    <div>
                        <div class="product-image">
                            <div class="image">
                                <a href="@PathUtil.GetCategoryPath(category)"><i class="fa fa-@icons[counter]"></i></a>
                            </div>
                        </div>
                        <div class="product-info">
                            <div class="name">
                                <a href="@PathUtil.GetCategoryPath(category)">
                                    @category.Name
                                    @if (category.Name?.Length < 16)
                                    {
                                        <br /><span>&nbsp;</span>
                                    }
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                counter++;
            }
        </div>

    </div>
</div>

