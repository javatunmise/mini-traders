@model IEnumerable<site.Data.Category>

@{ 
    var icons = new string[]
    {
        "fa fa-life-ring",
        "fa fa-desktop",
        "fa fa-diamond",
        "fa fa-camera",
        "fa fa-cutlery",
        "fa fa-balance-scale",
        "fa fa-female",
        "fa fa-soccer-ball-o",
        "fa fa-book",
        "fa fa-cab",
        "fa fa-",
        "fa fa-",
        "fa fa-",
        "fa fa-",
        "fa fa-",
    };

    var counter = 0;
}

<div class="featured-categories">
    @*<h2 style="color:#333">Top Categories</h2>*@
    <div class="owl-nav">
        <button role="presentation" class="owl-prev">&lt;</button>
        <button role="presentation" class="owl-next">&gt;</button>
    </div>
    <div class="featured-categories-inner">
        <div class="owl-carousel">

            @foreach (var category in Model)
            {
                <div class="item" style="width: 129px; display: inline-block">

                    <div>
                        <div class="product-image">
                            <div class="image">
                                <a href="/categories/123-fashion"><i class="@icons[counter]"></i></a>
                            </div>
                        </div>
                        <div class="product-info">
                            <div class="name">
                                <a href="/categories/123-fashion">
                                    @category.Name
                                    @if (category.Name?.Length < 20)
                                    {
                                        <br /><span>&nbsp;</span>
                                    }
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                counter++;
            }
        </div>

    </div>
</div>