@using site.Helpers;

@model site.Data.Site
@{
    var site = Model;
}

<div class="widget mb-2">
    <h4 class="widget-title mb-1 pb-1">Contact Info</h4>
    <ul class="contact-info m-b-4">
        <li>
            <span class="contact-info-label">Address:</span>@site.Address
        </li>
        <li>
            <span class="contact-info-label">Phone:</span><a href="tel:">@site.PhoneNumber</a>
        </li>
        <li>
            <span class="contact-info-label">Email:</span> <a href="mailto:@(site.Email)">@site.Email</a>
        </li>
        <li>
            <span class="contact-info-label">Working Days/Hours:</span>
            @site.WorkingHours
        </li>
    </ul>
    <div class="social-icons">
        <a href="@site.FacebookUrl.DefaultTo("#")" class="social-icon social-facebook icon-facebook" target="_blank" title="Facebook"></a>
        <a href="@site.TwitterUrl.DefaultTo("#")" class="social-icon social-twitter icon-twitter" target="_blank" title="Twitter"></a>
        <a href="@site.LinkedInUrl.DefaultTo("#")" class="social-icon social-linkedin fab fa-linkedin-in" target="_blank" title="Linkedin"></a>
        <a href="@site.YoutubeUrl.DefaultTo("#")" class="social-icon sicon-social-google fab fa-google-plus" target="_blank" title="Linkedin"></a>
        <a href="@site.InstagramUrl.DefaultTo("#")" class="social-icon social-instagram fab fa-instagram" target="_blank" title="Linkedin"></a>
    </div>
    <!-- End .social-icons -->
</div><!-- End .widget -->
