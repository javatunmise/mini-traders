@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
<div id="cookieConsent" class="alert alert-dark alert-dismissible fade fade-consent show pb-5" role="alert">
    By continuing to use this site or by clicking “Accept All Cookies”, you agree to the storing of cookies on your device to enhance site navigation, analyze site usage, 
    and assist in our marketing efforts.
    <a href="https://shopatfirstchoice.com/pages/7/Terms-and-conditions">Learn More</a>.
    <button type="button" class="accept-policy close" data-dismiss="alert" aria-label="Close" data-cookie-string="@cookieString">
        <span aria-hidden="true"><span style="padding:5px; border: solid 1px #111111">Accept All Cookies</span></span>
    </button>
</div>
    <script>
        (function () {
            var button = document.querySelector("#cookieConsent button[data-cookie-string]");
            button.addEventListener("click", function (event) {
                document.cookie = button.dataset.cookieString;
            }, false);
        })();
    </script>
}
