@model double
@{
    var rating = (int)Math.Floor(Model);
}



@for (int i = 0; i < rating; i++)
{
    <i class="fa fa-star" style="color: #f9b900; font-size: 16px"></i>
}

@for (int i = 0; i < 5-rating; i++)
{
    <i class="fa fa-star-o" style="color: #f9b900; font-size: 16px"></i>
}