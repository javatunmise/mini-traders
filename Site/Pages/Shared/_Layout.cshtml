                        @await Component.InvokeAsync("LocationMegaMenu", new { })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="top-right text-right">
                        <ul class="list-unstyled list-inline">
                            @if (loggedIn)
                            {
                                <li class="list-inline-item"><a href="~/profile"><b><span>Hi, </span>@Context.User.Identity.Name</b></a></li>
                            }
                            <li class="list-inline-item"><a href="~/profile/store"><img src="~/images/cart.png" alt="">Start Selling</a></li>
