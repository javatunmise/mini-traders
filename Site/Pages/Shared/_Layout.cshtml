                            {
                                <li class="list-inline-item"><a href="~/user/profile"><img src="~/images/user.png" alt="">My Account</a></li>
                                <li class="list-inline-item">
                                    <form id="logout" action="~/identity/account/logout" method="post">
                                        <a href="#" onclick="$('#logout').submit()"><img src="~/images/checkout.png" alt="">Logout</a>
                                    </form>
                                </li>
                            }
                            else
                            {
