@using site.Helpers;
@inject site.Data.ISiteContentProvider _provider;
@inject site.Repositories.AccountRepository _accountRepo;
@{
    var _site = (await _provider.GetSiteInfo()) ?? new site.Data.Site();
    var loggedIn = Context.User.Identity.IsAuthenticated;
    var userName = Context.User.Identity.Name;
    var siteName = "Shop@Firstchoice";

    var currentUser = await _accountRepo.FindByUsername(User.Identity.Name);
    var name = "<No Store Name>";
    var store = new global::Shared.Store(null);
    if (currentUser != null && currentUser.Store != null)
    {
        store = currentUser.Store;
        if (!string.IsNullOrEmpty(currentUser.Store.Name))
        {
            name = $"{currentUser.Store.Name}";
        }
    }
}


