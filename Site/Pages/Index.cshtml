@page

@inject site.Data.ISiteContentProvider  _siteContentProvider;
@inject Microsoft.Extensions.Configuration.IConfiguration configuration

@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = "Shared/_LayoutHome.cshtml";
}

@if (configuration["SiteLaunched"] == "false")
{
    <style type="text/css">
        body {
            background-image: url(images/under-construction.png);
            background-repeat: no-repeat;
            background-position: center;
        }
    </style>

    Layout = null;
    return;
}

<div class="container">
    <div class="row custom-margin">
        <div class="col-md-12">
            <a href="@Model.TopBannerFileName.Link" target="_self" class="vc_single_image-wrapper vc_box_border_grey">
                <img width="1160" height="102" src="@Url.Content("~/" + Model.TopBannerFileName.ImagePath)" alt="banner" />
            </a>
        </div>
    </div>
</div>

@if (Model.ShowGoogleAds)
{
    <div class="container">
        <div class="row custom-margin">
            <div class="col-md-12">
                @await Html.PartialAsync("_GoogleAds")
            </div>
        </div>
    </div>
}

<div class="container">
    <div class="row custom-margin">
        <div class="col-md-2 override-20">
            @await Component.InvokeAsync("AllCategoriesMenu")
        </div>
        <div class="col-md-10 override-80">
            @await Component.InvokeAsync("HomePageCarousel")
        </div>
    </div>
</div>


<div class="container">
    <div class="row custom-margin">
        <div class="col-xs-12">
            @await Component.InvokeAsync("HomePageTopCategories")
        </div>
    </div>
</div>


<div class="container">
    <div class="row custom-margin">
        <div class="col-md-6" style="margin-bottom: 15px">
            <img width="565" height="160" src="@Url.Content("~/" + Model.MiddleBanner1FileName.ImagePath)" alt="banner" />
        </div>
        <div class="col-md-6">
            <img width="565" height="160" src="@Url.Content("~/" + Model.MiddleBanner2FileName.ImagePath)" alt="banner" />
        </div>
    </div>
</div>

<div class="row custom-margin"></div>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            @await Component.InvokeAsync("ProductsGrid")
        </div>
    </div>
</div>


<div class="row custom-margin"></div>

<div class="container">
    <div class="row">
        <div class="col-md-12 text-center">
            <div style="background: #ffffff">
                <img class="img-responsive" style="max-height:220px; margin: auto" src="@Url.Content("~/" + Model.BannerAfterMiddleFileName.ImagePath)" alt="banner" />
            </div>
        </div>
    </div>
</div>

<div class="row custom-margin"></div>

@await Component.InvokeAsync("ProductsGrid_Recommended")

<div class="row custom-margin"></div>

<div class="home-services-bg-img">
    <div style="background: #85014de6; padding: 15px 0;">
        @await Component.InvokeAsync("ProductsGrid_Services")
    </div>
</div>

<div class="row custom-margin"></div>

@await Component.InvokeAsync("ProductsGrid_FlashDeals")

@section Scripts {
    <script src="~/js/multi-countdown.js"></script>
}