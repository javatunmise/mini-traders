@page "{id}"
@model site.Pages.Profile.Store.EditProductModel
@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Pages/Shared/_LayoutStore.cshtml";
    var CategoriesListItems = new SelectList(Model.TopCategories.Where(e => e.Parent == null), "Id", "Name", Model.FormInput.CategoryId);
    var hierarchies = Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategoriesHierarchy.Select(x => new { x.Id, ParentId = x.Parent?.Id, x.Name }));
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page"><a href="/Profile/Store">Store</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit - @Model.FormInput.Name</li>
    </ol>
}

<h3 class="page-title-notpadded">@Model.FormInput.Name</h3>

<form method="post" enctype="multipart/form-data" id="editform">

    <div class="text-danger" asp-validation-summary="All"></div>

    <div class="">
        <label>Category <span class="required">*</span></label>
        <select asp-for="FormInput.CategoryId" class="form-control" asp-items="CategoriesListItems" onchange="loadLeve2Categories(this)">
        </select>
    </div>

    <div id="level2dropdown_div">
        <br />
        <select id="level2dropdown" class="form-control" onchange="loadLeve3Categories(this)" asp-for="Level2Category">
            <option value="">-- Select --</option>
        </select>
    </div>

    <div id="level3dropdown_div">
        <br />
        <select id="level3dropdown" class="form-control" asp-for="Level3Category">
            <option value="">-- Select --</option>
        </select>
    </div>


    <br />
    <div class="">
        <label>Name <span class="required">*</span></label>
        <input asp-for="FormInput.Name" class="form-control">
    </div>

    <br />
    <div class="">
        <label>Description & Specifications</label>
        <textarea asp-for="FormInput.Description" class="form-control"></textarea>
    </div>

    <br />
    <div class="form-row">
        <div class="form-group col-md-3">
            <label>
                Specifications e.g. <br />
                Weight: 200kg<br />
                Color: Red<br />
                Size: Medium<br />
            </label>
        </div>
        <div class="form-group col-md-9">
            <textarea rows="3" asp-for="FormInput.Specifications" class="form-control"></textarea>
        </div>
    </div>

    <br />
    <div class="form-group">
        <label>Price <span class="required">*</span></label>
        <input asp-for="FormInput.Price" class="form-control">
    </div>

    <div class="form-group">
        <label>Image <span class="required">*</span></label>
        <input asp-for="FormInput.ImageUpload" class="form-control" multiple>

    </div>

    <div class="form-group">
        <label>Change Status <span class="required">*</span></label>
        <select asp-for="FormInput.Status" class="form-control" asp-items="Model.StatusList">
        </select>

    </div>

    <input type="hidden" name="action" id="form_action" />

    <button type="submit" class="btn btn-warning">Save</button>
    &nbsp;&nbsp;&nbsp;&nbsp;
    <button type="button" class="btn btn-danger" onclick="return onDeleteClick()"><i class="fa fa-trash"></i>&nbsp; Delete this product</button>


</form>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        function onDeleteClick() {
            confirmed = window.confirm('Are you sure you want to delete this item? Click OK to continue')
            if (!confirmed) return;

            document.getElementById('form_action').value = 'deleted';

            form = document.getElementById("editform");
            form.submit();
        }
    </script>
    <script type="text/javascript">
        var hierarchies = @Html.Raw(hierarchies)

        var twoLevels = ['level2dropdown', 'level3dropdown'];
        var lastLevel = ['level3dropdown'];

        function loadLeve2Categories(dd) {
            var category = dd.value;

            if (category === '') {
                hidedropdowns(twoLevels);
                return;
            }

            showNextDropdown(category, 2);
        }

        function loadLeve3Categories(dd) {
            var category = dd.value;

            if (category === '') {
                hidedropdowns(lastLevel);
                return;
            }

            showNextDropdown(category, 1);
        }


        function hidedropdowns(dds) {
            for (var i = 0; i < dds.length; i++) {
                document.getElementById(dds[i] + '_div').style.display = 'none';
                $('#' + dds[i]).empty();
            }
        }

        function showNextDropdown(category, levelDown) {
            if (levelDown == 2) {
                hidedropdowns(twoLevels);
                var sub = hierarchies.filter(f => f.ParentId == category)

                if (sub.length > 0) {
                    document.getElementById('level2dropdown_div').style.display = 'block';
                    var dd = $('#level2dropdown');
                    dd.empty();

                    dd.append($('<option></option>').val('').html('-- Select --'))
                   for (var i = 0; i < sub.length; i++) {
                        dd.append($('<option></option>').val(sub[i].Id).html(sub[i].Name))
                    }
                }
            }

            if (levelDown == 1) {
                var sub = hierarchies.filter(f => f.ParentId == category)
                if (sub.length == 0) {
                    hidedropdowns(lastLevel)
                    return;
                }

                document.getElementById('level3dropdown_div').style.display = 'block';
                var dd = $('#level3dropdown');
                dd.empty();

                dd.append($('<option></option>').val('').html('-- Select --'))
               for (var i = 0; i < sub.length; i++) {
                    dd.append($('<option></option>').val(sub[i].Id).html(sub[i].Name))
                }
            }
        }

        @if (Model.Level2Category.HasValue) {
            <text>
                showNextDropdown(@Model.FormInput.CategoryId, 2);
                $('#level2dropdown').val(@Model.Level2Category.Value)
            </text>
        }

        @if (Model.Level3Category.HasValue && Model.Level2Category.HasValue) {
            <text>showNextDropdown(@Model.Level2Category.Value, 1);
            $('#level3dropdown').val(@Model.Level3Category.Value)
            </text>
        }
    </script>


}
