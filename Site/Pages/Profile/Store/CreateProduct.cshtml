@page
@model site.Pages.Profile.Store.CreateProductModel
@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Pages/Shared/_LayoutStore.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page"><a href="/Profile/Store">Store</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create a Product or Service</li>
    </ol>
}

<h3 class="page-title-notpadded">Create a Product or Service</h3>

<form method="post">

    <div class="">
        <label>Category <span class="required">*</span></label>
        <select class="form-control">
            <option>Services</option>
            <option>Electronics</option>
        </select>
    </div>

    <br />
    <div class="">
        <label>Name <span class="required">*</span></label>
        <input class="form-control unicase-form-control ">
    </div>

    <br />
    <div class="">
        <label>Description & Specifications</label>
        <textarea class="form-control unicase-form-control"></textarea>
    </div>

    <br />
    <div class="form-group">
        <label for="Input.ContactPhone">Price <span class="required">*</span></label>
        <input for="Input.ContactPhone" class="form-control">
    </div>

    <div class="form-group">
        <label for="DocUpload">Image <span class="required">*</span></label>
        <input class="form-control" for="DocUpload" type="file">

    </div>

    <button type="submit" class="btn btn-primary">Save</button>

</form>