@page
@model site.Pages.Profile.Store.IndexModel
@{
    ViewData["Title"] = "MY STORE";

    Layout = "~/Pages/Shared/_LayoutStore.cshtml";

    var selectedValue = Model.SearchQuery.FilterByServices ? "Services" : "Products";
    var filterOptions = new SelectList(new[]{"Products","Services"}, selectedValue);

    Func<int, string> GetEditProductUrl = productId => $"./Store/EditProduct/{productId}";
}


@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page">My Store</li>
    </ol>
}

<div class="store-items">

    <div class="alert alert-danger @(Model.StoreHasNotBeenActivated ? "visible": "hide")">
        Please note that your products and services will not be visible to customers
        until you activate your account. <a href="/payments/@Model.ActivationPaymentCode">Activate here</a>
    </div>

    <div class="store-filter" style="border-bottom: solid 1px #ddd">

        <form class="form-inline">
            <label class="sr-only" for="inlineFormInputName2">Merchandize</label>
            <select name="filter" class="form-control mb-2 mr-sm-2" asp-items="filterOptions">
            </select>

            <button type="submit" class="btn btn-primary mb-2">Search</button>
        </form>
    </div>
    <br />

    @if (Model.Products.Any())
    {

        <ul class="list-unstyled product-mob-view">
            @foreach (var product in Model.Products)
            {
                <li class="media listing">
                    <img src="@Url.Content("~/" + product.ImageUrl)" class="mr-3" alt="...">
                    <div class="media-body">
                        <h4 class="mt-0 mb-1">@product.Name</h4>
                        @product.ProductDetails
                        <div>Price: @product.Price.ToString("N2")</div>
                        <div>Status: @product.Status</div>

                        <div class="action-buttons">
                            <a href="@GetEditProductUrl(product.Id)" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i> Edit</a>
                        </div>
                    </div>
                </li>
            }
        </ul>

        <table class="table table-striped product-desktop-view">
            <thead>
                <tr>
                    <th style="width:120px"></th>
                    <th>Details</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <a href="@PathUtil.GetProductPath(product)">
                                <img src="@Url.Content("~/" + product.ImageUrl)" style="height:100px; width:100px" class="img-fluid" alt="...">
                            </a>
                        </td>
                        <td>
                            <h4 class="mt-0 mb-1">@product.Name</h4>
                            @product.ProductDetails
                        </td>
                        <td>
                            Price: @product.Price.ToString("N2")
                            <br />
                            Old Price: @product.OldPrice.ToString("N2")
                        </td>
                        <td>@product.Status</td>
                        <td>
                            <a href="@GetEditProductUrl(product.Id)" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i> Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


        <hr />

        <nav aria-label="Page navigation example" style="float: right;">
            <ul class="pagination justify-content-end">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                </li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                </li>
            </ul>
        </nav>
    }


    <h4 class="text-center @(Model.Products.Any() ? "hide": "visible")">
        You do not have any items uploaded in this category.
        <br />
        <a href="/Profile/Store/CreateProduct">Start creating items here</a>
    </h4>
</div>

