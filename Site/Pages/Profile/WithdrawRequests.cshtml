@page
@model site.Pages.Profile.WithdrawRequestsModel
@{
    ViewData["Title"] = "Withdrawal Requests";
    Layout = "~/Pages/Shared/_LayoutProfile.cshtml";
}


@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item"><a href="/Profile/MyWallet">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page">Withdrawal Requests</li>
    </ol>
}

<h3 class="page-title-notpadded">Withdrawal Requests</h3>


<table class="table table-striped table-bordered @(Model.Requests.Any() ? "visible": "hide")">
    <thead>
        <tr>
            <th>Date</th>
            <th>Amount</th>
            <th>Charge</th>
            <th>Bank Account</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.Requests)
        {
            <tr>
                <td>@request.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>
                <td>@request.Amount.ToString("N2")</td>
                <td>@request.Charge.ToString("N2")</td>
                <td>@request.AccountNumber @request.BankName</td>
                <td>
                    <ul style="list-style-type: square; margin-left: 15px">
                        @{
                            var historyCount = 0;
                            foreach (var history in request.WorkflowHistories.OrderByDescending(e => e.CreatedOn))
                            {
                                if (historyCount > 0)
                                {
                                    <li>@($"{history.CreatedOn:dd-MMM-yyyy hh:mm tt} {history.Status}")</li>
                                }
                                else
                                {
                                    <li><b>@($"{history.CreatedOn:dd-MMM-yyyy hh:mm tt} {history.Status}")</b></li>
                                }

                                historyCount++;
                            }
                        }
                    </ul>
                    <br />
                    @if (request.Status == global::Shared.Entities.WithdrawRequestStatuses.Submitted)
                    {
                        <div>
                            <form method="post" onsubmit="return confirm('Are you sure you want to cancel? Click OK to cancel')">
                                <input type="hidden" value="@request.Id" name="RequestId" />
                                <button type="submit" class="btn btn-xs btn-danger">Cancel Request</button>
                            </form>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="alert alert-secondary @(Model.Requests.Any() ? "hide": "visible")">
    You have no withdrawal requests
</div>
