@page
@model site.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Pages/Shared/_LayoutProfile.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Profile</li>
    </ol>
}


    @*<h2 class="profile-page-title">Profile</h2>*@

    <form>
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="ProfileEdit.FirstName">First name</label>
            <input asp-for="ProfileEdit.FirstName" class="form-control">
            @*<small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>*@
        </div>
        <div class="form-group">
            <label asp-for="ProfileEdit.LastName">Last name</label>
            <input asp-for="ProfileEdit.LastName" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>



