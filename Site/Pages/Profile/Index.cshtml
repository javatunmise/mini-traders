@page
@model site.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Pages/Shared/_LayoutProfile.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Profile</li>
    </ol>
}


<h3 class="page-title-notpadded">Personal Details</h3>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ProfileEdit.FirstName">First name</label>
        <input asp-for="ProfileEdit.FirstName" class="form-control">
        @*<small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>*@
    </div>
    <div class="form-group">
        <label asp-for="ProfileEdit.LastName">Last name</label>
        <input asp-for="ProfileEdit.LastName" class="form-control">
    </div>
    <div class="form-group">
        <label asp-for="ImageUpload">Change your profile picture <span class="required">*</span></label>
        <input class="form-control" asp-for="ImageUpload">

    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}

