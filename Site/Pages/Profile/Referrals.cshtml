@page
@model site.Pages.Profile.ReferralsModel
@{
    ViewData["Title"] = "Referrals";
    Layout = "~/Pages/Shared/_LayoutProfile.cshtml";

    var referralCode = "K93400100";
    var referralLink = Url.Page("/sellers/registration", null, new { ref_id = referralCode }, protocol: Request.Scheme);
}


@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page">Referrals</li>
    </ol>
}

<h3 class="page-title-notpadded">Referrals</h3>

<div class="alert alert-info">
    <div>Earn some rewards by referring sellers to this site.</div>
    <div> Here is your referral link: <b>@referralLink</b></div>
    <div> Your referrals can also enter the following code when registering: <b>@referralCode</b></div>

    <br />
    <a href="/pages/referral-details" class="btn btn-sm btn-info">Learn more</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Store</th>
            <th>Date Joined</th>
        </tr>
    </thead>
    <tbody>
        @for(int i=0; i< 3; i++)
        {
            var names = new[] { "Segun", "Shola", "Margaret" };
            var storeName = "Wisdom Facials";
        <tr>
            <td>@names[i]</td>
            <td>@storeName</td>
            <td>@DateTime.Now</td>
        </tr>
        }
    </tbody>
</table>