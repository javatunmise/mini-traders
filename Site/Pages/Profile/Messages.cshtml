@page
@model site.Pages.Profile.MessagesModel
@{
    ViewData["Title"] = "Referrals";
    Layout = "~/Pages/Shared/_LayoutProfile.cshtml";
}


@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/Profile">Profile</a></li>
        <li class="breadcrumb-item active" aria-current="page">Messages</li>
    </ol>
}

<h3 class="page-title-notpadded">Messages</h3>

<table class="table table-striped table-bordered @(Model.Messages.Any() ? "visible": "hide")">
    <tbody>
        @foreach(var message in Model.Messages)
        {
        <tr>
            <td>
                <div class="media">
                    <img src="@Url.Content("~/" + message.ProfilePicture)" style="width:40px; height: 40px" class="align-self-start mr-3 img-circle" alt="...">
                    <div class="media-body">
                        <h5 class="mt-0">@($"{message.SiteUser.FirstName} {message.SiteUser.LastName}") @message.CreatedOn.ToString("dd-MMM-yyyy HH:mm")</h5>
                        <p>@message.Message</p>
                        <p><a href="/profile/messagehistory/@message.ChatId">View chat history</a></p>
                    </div>
                </div>
            </td>
        </tr>
        }
    </tbody>
</table>

