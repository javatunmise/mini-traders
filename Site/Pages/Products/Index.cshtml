@page "/products/{id}-{name}"

@model site.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Index";
    int counter = 0;

    var product = Model.Product ?? new site.Data.Product();
    var vendor = Model.Vendor ?? new site.Data.Vendor();

    var lines = from line in product.OtherFeatures.Split('\n')
                let pair = line.Split(':')
                where pair.Length == 2
                select new KeyValuePair<string, string>(pair[0], pair[1]);

}

<style type="text/css">
    .product-area {
        padding-top: 15px;
    }

        .product-area img {
            width: 100%;
        }

        .product-area .product-title {
            margin-top: 0;
        }

    .vendor-area {
        padding: 15px;
    }

        .vendor-area .vert-indent {
            padding: 15px 0;
        }

        .vendor-area .image {
            text-align: center;
            padding: 15px;
        }

        .vendor-area .vendor-name {
            text-align: center;
            margin-top: 0;
        }

        .vendor-area .image img {
            width: 60%;
            border-radius: 50%;
        }

    .divider {
        height: 1px;
        border-bottom: solid 1px #eeeeee;
        margin: 15px 0;
    }

        .divider.hint {
            border-bottom: solid 1px #f9b900;
        }

    .price-before {
        font-size: 18px;
    }

    .price-current {
        font-size: 25px;
    }

    .chat-box textarea {
        width: 100%;
    }


    .social li a:before {
        display: none;
    }

    .social li a {
        font-size: 16px;
        display: inline-block !important;
        text-align: center;
        padding: 0;
    }

    .social li.facebook a {
        background: #3C5B9B !important;
    }

    .social li.twitter a {
        background: #359BED !important;
    }

    .social li.google-plus a {
        background: #E33729 !important;
    }

    .social li.pinterest a {
        background: #cb2027 !important;
    }
</style>

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">@product.Name</li>
    </ol>
}

<div class="row custom-margin"></div>


<div class="container">

    <div class="card site-page-content">
        <div class="card-body" style="padding: 0">

            <div class="row" style="padding: 0">
                <div class="product-area col-md-9">
                    <div class="col-md-6">

                        <div>
                            <!-- product-image -->
                            <img src="~/@product.SmallImageUrl" />
                        </div>

                        <br />
                        <div>
                            <!-- slider -->

                            <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
                                <div class="carousel-inner h-100">
                                    @foreach (var banner in Enumerable.Range(0,10).Select((b, index) => new { filename = product.SmallImageUrl, index }))
                                    {
                                        <div class="carousel-item h-100 @(banner.index == 0 ? "active" : "")">
                                            <a href="#">
                                                <img class="d-block" src="~/@product.SmallImageUrl" alt="First slide" style="width:100px">
                                            </a>
                                        </div>
                                    }
                                </div>

                                <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Previous</span>
                                </a>
                                <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Next</span>
                                </a>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-6">
                        <h2 class="product-title">@product.Name</h2>
                        <div>
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="fa fa-star" style="color: #f9b900; font-size: 16px"></i>
                            }

                            &nbsp;
                            <span>(0 customer review)</span>
                        </div>

                        <div class="divider"></div>

                        <div class="price">
                            <span class="price-before">N@(product.OldPrice.ToString("N2"))</span>
                            <span class="price-current">N@(product.Price.ToString("N2"))</span>
                        </div>

                        <div class="divider"></div>

                        <div class="social-icons">
                            <div class="col-xs-12 col-sm-12 col-md-12 no-padding social" style="padding:0">
                                <ul class="link">
                                    <li class="facebook"><a href="#" target="_blank"> <i class="fa fa-facebook"></i></a></li>
                                    <li class="twitter"><a href="#" target="_blank"> <i class="fa fa-twitter"></i></a></li>
                                    <li class="instagram"><a href="#" target="_blank"> <i class="fa fa-instagram"></i></a></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-3">
                    <div class="vendor-area" style="background: #f3f3f3">
                        <div class="image">
                            <img src="~/images/vendor-photo.png" alt="Vendor Picture or Logo" />
                        </div>
                        <h3 class="vendor-name">@vendor.Name</h3>

                        <div class="divider"></div>

                        <div><h3>@vendor.Contact?.PhoneNumber</h3></div>

                        <div class="divider"></div>

                        <div class="chat-box vert-indent">
                            <textarea rows="4">Send message to seller</textarea>

                            <div id="chat-box-buttons">
                                <button class="btn btn-primary">Post</button>
                            </div>
                        </div>
                        <div>Safety Tips</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row custom-margin"></div>

<div class="container">
    <div class="card">
        <div class="card-body site-page-content">
            <h3 class="title">Product Details</h3>

            @product.ProductDetails
        </div>
    </div>
</div>

<div class="row custom-margin"></div>

<div class="container">
    <div class="card">
        <div class="card-body site-page-content">
            <h3 class="title">Other features and specifications</h3>



            <ul class="-pvs -mvxs -phm -lsn">
                @foreach (var spec in lines)
                {
                    <li class="-pvxs"><span class="-b">@spec.Key</span>: @spec.Value</li>
                }
            </ul>
        </div>
    </div>
</div>


<div class="row custom-margin"></div>

<div class="container">
    <div class="card">
        <div class="card-body site-page-content">
            <h3 class="title">Reviews</h3>

            <div>No reviews</div>
        </div>
    </div>
</div>

<div class="row custom-margin"></div>

<div class="container">
    <div class="home-recommended">
        <div class="home-recommended-header row">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12"><h2 style="color:#333" class="title">Related Products</h2></div>
            <div class="col-lg-7 col-md-6 col-sm-10 col-xs-9" style="padding-top: 15px">

            </div>
            <div class="col-lg-1 col-md-2 col-sm-2 col-xs-3">
                <div class="owl-nav">
                    <button role="presentation" class="owl-prev">&lt;</button>
                    <button role="presentation" class="owl-next">&gt;</button>
                </div>
            </div>
        </div>

        <div class="carousel-wrapper">
            <div class="owl-carousel two">

                @foreach (var _product in Enumerable.Range(0, 5).Select(c => new site.Data.Category { }))
                {
                    <div class="item item-carousel" style="">
                        <div class="image">
                            <a href="/product/the-crash-bad-instant-folding-long-twin-bed-3/"><img src="~/images/products/product-@(counter % 4 + 1).jpg" alt="The Crash Bad Instant Folding long Twin Bed"></a>
                        </div>

                        <div class="title"><a href="/products/123-same products">The Crash Bad Instant Folding long Twin Bed</a></div>
                        <div class="rating">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                        </div>
                        <div class="price">
                            <span class="price-before">N120.00</span>
                            <span class="price-current">N100.00</span>
                        </div>
                    </div>

                    counter++;
                }
            </div>
        </div>

    </div>
</div>

