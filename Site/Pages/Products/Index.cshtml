@page "/products/{id}-{name}"

@model site.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Index";
    int counter = 0;

    var product = Model.Product ?? new global::Shared.ViewModels.ProductView();
    var vendor = Model.Vendor ?? new site.Data.Vendor { Contact = new site.Data.VendorContact() };

    Func<Microsoft.AspNetCore.Http.HttpRequest, string> absolutePath = (request) => $"http://rapidoiz.com{request.Path.Value}";
}

@section MetaTags {
    <!-- You can use Open Graph tags to customize link previews.
    Learn more: https://developers.facebook.com/docs/sharing/webmasters -->
    <meta property="og:url" content="@absolutePath(Request)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@product.Name" />
    <meta property="og:description" content="@product.ProductDetails" />
    <meta property="og:image" content="~/@product.SmallImageUrl" />
}

<style type="text/css">
    .product-area {
        padding-top: 15px;
    }

    .product-image {
        height: 250px;
        line-height: 250px;
        text-align: center;
    }

    .product-area img {
        /*width: 100%;*/
        max-height: 250px;
        vertical-align: middle;
    }

    .a-review img {
        width: 65px;
    }

    .a-review textarea {
        width: 100%;
    }

    .product-area .product-title {
        margin-top: 0;
    }

    .vendor-area {
        padding: 15px;
    }

        .vendor-area .vert-indent {
            padding: 15px 0;
        }

        .vendor-area .image {
            text-align: center;
            padding: 15px;
        }

        .vendor-area .vendor-name {
            text-align: center;
            margin-top: 0;
        }

        .vendor-area .image img {
            width: 80px;
            border-radius: 50%;
        }

    .divider {
        height: 1px;
        border-bottom: solid 1px #eeeeee;
        margin: 15px 0;
    }

        .divider.hint {
            border-bottom: solid 1px #f9b900;
        }

    .price-before {
        font-size: 18px;
    }

    .price-current {
        font-size: 25px;
    }

    .chat-box textarea {
        width: 100%;
    }

    .chat-box .buttons {
        margin-top: 15px;
    }

    .social li a:before {
        display: none;
    }

    .social li a {
        font-size: 16px;
        display: inline-block !important;
        text-align: center;
        padding: 0;
    }

    .social li.facebook a {
        background: #3C5B9B !important;
    }

    .social li.twitter a {
        background: #359BED !important;
    }

    .social li.google-plus a {
        background: #E33729 !important;
    }

    .social li.pinterest a {
        background: #cb2027 !important;
    }

    .product-ratings i {
        color: #cb2027;
    }
</style>

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item"><a href="/categories/@product.CategoryId/@product.CategoryName">@product.CategoryName</a></li>
        <li class="list-inline-item">@product.Name</li>
    </ol>
}

<div class="row custom-margin"></div>

<a class="twitter-share-button"
   href="https://twitter.com/intent/tweet">
    Tweet
</a>


<div class="container">

    <div class="card site-page-content">
        <div class="card-body" style="padding: 0">

            <div class="row" style="padding: 0">
                <div class="product-area col-md-9">
                    <div class="col-md-6">

                        <div class="product-image">
                            <!-- product-image -->
                            <img src="~/@product.SmallImageUrl" />
                        </div>

                        <br />
                        <div>
                            <!-- slider -->

                            <div class="carousel-wrapper">
                                <div class="owl-carousel owl-theme">
                                    @foreach (var path in Model.OtherImageUrls)
                                    {
                                        <div class="item item-carousel">
                                            <a href="javascript:replaceImage('../@path')">
                                                <img class="d-block" src="~/@path" alt="First slide" style="width:100px">
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-6">
                        <h2 class="product-title">@product.Name</h2>
                        <div>
                            <partial name="Shared/TempViews/_Ratings" model="@product.AverageRating" />

                            &nbsp;
                            <span>(@product.ReviewsCount customer review)</span>
                        </div>

                        <div class="divider"></div>

                        <div class="price">
                            <span class="price-before @(product.Price == product.OldPrice ? "hide" : "")">N@(product.OldPrice.ToString("N2"))</span>
                            <span class="price-current">N@(product.Price.ToString("N2"))</span>
                        </div>

                        <div class="divider"></div>

                        @product.ProductDetails

                        <div class="divider"></div>

                        <div class="social-icons">
                            <div class="col-xs-12 col-sm-12 col-md-12 no-padding social" style="padding:0">
                                <ul class="link">
                                    <li class="facebook">
                                        <a href="https://www.facebook.com/sharer/sharer.php?kid_directed_site=0&sdk=joey&u=@(absolutePath(Request))&display=popup&ref=plugin&src=share_button" target="_blank"> 
                                            <i class="fa fa-facebook"></i></a>
                                    </li>
                                    <li class="twitter"><a href="#" target="_blank"> <i class="fa fa-twitter"></i></a></li>
                                    <li class="instagram"><a href="#" target="_blank"> <i class="fa fa-instagram"></i></a></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-3">
                    <div class="vendor-area" style="background: #f3f3f3; text-align: center">
                        <div class="image">
                            <a href="/Sellers/@vendor.VendorId">
                                <img src="@Url.Content("~/" + vendor.LogoUrl)" alt="Vendor Picture or Logo" />
                            </a>
                        </div>
                        <a href="/Sellers/@vendor.VendorId"><h4 class="vendor-name">@vendor.Name</h4></a>

                        <div class="divider"></div>

                        <div><h4>@vendor.Contact?.PhoneNumber</h4></div>

                        <div class="divider"></div>

                        <div class="chat-box vert-indent">
                            <div class="text-danger mb-2" style="display: none" id="post-msg-error">Unable to send message. Please try again later.</div>
                            <div class="text-success mb-2" style="display: none" id="post-msg-success">Message sent!</div>
                            <div class="text-danger mb-2" style="display: none" id="post-msg-length-error">Message must be at least 20 characters</div>
                            <textarea id="seller-msg" class="form-control" rows="4" placeholder="Send message to seller"></textarea>

                            <div class="buttons">
                                <button onclick="postMessage()" class="btn btn-primary">Post</button>
                                <img id="post-msg-spinner" src="~/images/spinner.jpg" style="height:40px; display: none" />
                            </div>
                        </div>
                        <div>Safety Tips</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row custom-margin"></div>

@*<div class="container">
        <div class="card">
            <div class="card-body site-page-content">
                <h3 class="title">Product Details</h3>

                @product.ProductDetails
            </div>
        </div>
    </div>*@

@*<div class="row custom-margin"></div>*@

<div class="container">
    <div class="card">
        <div class="card-body site-page-content">
            <h3 class="title">Other features and specifications</h3>



            <table cellpadding="5">
                @foreach (var spec in Model.Product.ProductSpecList)
                {
                    <tr>
                        <td width="100px" class="text-right">@spec.Key:</td>
                        <td>@spec.Value</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>


<div class="row custom-margin"></div>

<div class="container">
    <div class="card">
        <div class="card-body site-page-content">
            <h3 class="title">Reviews</h3>

            @foreach (var review in Model.ProductReviews)
            {
                <div class="media a-review">
                    <img class="align-self-start mr-3 img-circle" style="width: 40px; height: 40px" src="@Url.Content("~/" + review.ProfilePicturePath)" alt="Generic placeholder image">
                    <div class="media-body">
                        <div class="product-ratings">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                            @for (int i = 0; i < 5 - review.Rating; i++)
                            {
                                <i class="fa fa-star-o"></i>
                            }
                        </div>

                        <p> <strong>@review.ReviewerName</strong> - @review.Date.ToString("MMMM dd, yyyy")</p>
                        <p>
                            @review.Feedback
                        </p>
                    </div>
                </div>
            }

            @if (Model.ProductReviews.Count >= 5)
            {
                <div><a href="./@product.Id/allreviews">See all reviews</a></div>
            }

            <div class="media a-review" id="review-box">
                <img class="align-self-start mr-3" src="~/images/vendor-photo.png" alt="Generic placeholder image">
                <div class="media-body">
                    <div class="product-ratings">
                        <span>Your rating: </span>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <input type="radio" name="rating" id="rating_@i" onclick="document.getElementById('rating_value').value = @i" /> <span>@i</span>
                        }
                        <input type="hidden" id="rating_value" />
                    </div>
                    <div class="text-danger" style="display:none" id="review-rating-error">Please select a rating</div>

                    <p>How did you feel about this product or the vendor</p>
                    <p>
                        <div class="text-danger" style="display:none" id="review-comment-error">Comment must be at least 10 characters</div>
                        <div class="text-danger" style="display:none" id="post-review-error">Unable to submit your review. Please try again later</div>
                        <textarea id="review-msg" class="form-control"></textarea>
                    </p>

                    <input type="hidden" name="product_id" id="product_id" value="@product.Id" />
                    <input type="hidden" name="store_id" id="store_id" value="@product.Id" />

                    <button onclick="postReview()" class="btn btn-primary">Submit</button>
                    <img id="post-review-spinner" src="~/images/spinner.jpg" style="height:40px; display: none" />
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row custom-margin"></div>

<div class="container @(Model.RelatedProducts.Any() ? "" : "hide")">
    <div class="home-recommended">
        <div class="home-recommended-header row">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12"><h2 style="color:#333" class="title">Related Products</h2></div>
            <div class="col-lg-7 col-md-6 col-sm-10 col-xs-9" style="padding-top: 15px">

            </div>
            <div class="col-lg-1 col-md-2 col-sm-2 col-xs-3">
                <div class="owl-nav">
                    <button role="presentation" class="owl-prev">&lt;</button>
                    <button role="presentation" class="owl-next">&gt;</button>
                </div>
            </div>
        </div>

        <div class="carousel-wrapper">
            <div class="owl-carousel two">

                @foreach (var _product in Model.RelatedProducts)
                {
                    <div class="item item-carousel" style="">
                        <div class="image">
                            <a href="/products/@($"{_product.Id}-{_product.Name}")"><img src="@Url.Content("~/"+_product.SmallImageUrl)" alt="@_product.Name"></a>
                        </div>

                        <div class="title"><a href="/products/@($"{_product.Id}-{_product.Name}")">@_product.Name</a></div>
                        <div class="rating">
                            @for (int i = 0; i < _product.AverageRating; i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                        </div>
                        <div class="price">
                            <span class="price-before @(_product.Price == _product.OldPrice ? "hide" : "")">N@_product.OldPrice.ToString("N2")</span>
                            <span class="price-current">N@_product.Price.ToString("N2")</span>
                        </div>
                    </div>

                    counter++;
                }
            </div>
        </div>

    </div>
</div>


@section Scripts {

    <script type="text/javascript">

        function postReview() {
            showHideElements(false, ['#review-comment-error', '#review-rating-error', '#post-review-error'])

            var msg = document.getElementById('review-msg').value;
            var rating = document.getElementById('rating_value').value;

            if (msg.length < 10) {
                showHideElement(true, '#review-comment-error');
                return;
            }
            if (rating == '') {
                showHideElement(true, '#review-rating-error');
                return;
            }

            var data = {
                "message": msg,
                "rating": parseFloat(rating),
                "productId": @product.Id,
                "storeId": @product.StoreId
            };

            showHideElement(true, '#post-review-spinner');
            fetch('/api/operations/productreviews', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(data => {
                showHideElement(false, '#post-review-spinner');
                showSuccessMessage("#post-review");
                $('#review-box').html('<div class="alert alert-success">Thanks! Your review has been taken.</div>');
            })
            .catch(function (e) {
                showHideElement(false, '#post-review-spinner');
                showErrorMessage("#post-review");
            });
    }
        function postMessage() {
            showHideElements(false, ['#post-msg-error', '#post-msg-success', '#post-msg-length-error'])

            var msg = document.getElementById('seller-msg').value;

            if (msg.length < 20) {
                showHideElement(true, '#post-msg-length-error');
                return;
            }

            var data = {
                "message": msg,
                "productId": @product.Id,
                "storeId": @product.StoreId
            }

            showHideElement(true, '#post-msg-spinner');
            fetch('/api/operations/vendormessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
                })
                .then(response => {
                    if (response.ok) return response;

                    throw new Error("error");
                })
                .then(data => {
                    showSuccessMessage("#post-msg");
                    document.getElementById('seller-msg').value = '';
                    showHideElement(false, '#post-msg-spinner');
                })
                .catch(function (e) {
                    showHideElement(false, '#post-msg-spinner');
                    console.log("exception thrown" + e)
                    showErrorMessage("#post-msg");
                });
        }

        function showHideElement(show, elem_id) {
            if (show) {
                $('' + elem_id).show();
            }
            else {
                $('' + elem_id).hide();
            }
        }

        function showSuccessMessage(elem_id){
            $(elem_id+'-error').hide();
            $(elem_id+'-success').show();
        }

        function showErrorMessage(elem_id){
            $(elem_id+'-success').hide();
            $(elem_id+'-error').show();
        }

        function showHideElements(show, elems) {
            if (!elems || elems.length == 0) return;
            for (i = 0; i < elems.length; i++)
                showHideElement(show, elems[i]);
        }

    </script>

    <script type="text/javascript">
        function replaceImage(image) {
            $('.product-image img').attr('src', image);
        }
    </script>

    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script>
        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v3.0";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));</script>
}
