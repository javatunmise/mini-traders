@page "/categories/{id}-{name}"

@using site.ViewComponents;
@inject site.Data.ISiteContentProvider  _siteContentProvider;
@model site.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Index";
}

    <link href="~/css/site-products-list.css" rel="stylesheet" />

    <div class="body-content outer-top-ts">
        <div class="container">
            <div class="row">
                <div class="col-sm-9 col-sm-push-3">
                    @*<div id="category" class="category-carousel hidden-xs">
                        <div class="item">
                            <div class="image"> <img src="/uploads/2019/12/cat-banner-1.jpg" alt="BIG SALE" class="img-responsive"></div><div class="container-fluid">
                                <div class="caption vertical-top text-left">
