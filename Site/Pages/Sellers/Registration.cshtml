@page
@model site.Pages.Sellers.RegistrationModel
@{
    ViewData["Title"] = "Registration";
}

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">Sellers</li>
        <li class="list-inline-item">Registration</li>
    </ol>
}

<div class="row custom-margin"></div>
<div class="row custom-margin"></div>


<div class="container">

    <div class="row">
        <div class="col-md-12">
            <div class="sign-in-page">
                <div class="row">
                    <div class="col-md-12 col-sm-12 sign-in">
                        <div class="wcmp_regi_main">
                            <form class="register-form outer-top-xs register" role="form" method="post" enctype="multipart/form-data">
                                <h4>Vendor Registration Form</h4>

                                <div class="wcmp_regi_form_box">

                                    <div class="wcmp-regi-12">
                                        <label for="reg_username">Username <span class="required">*</span></label>
                                        <input type="text" class="form-control unicase-form-control " name="username" id="reg_username" value="" required="required">
                                    </div>
                                    <div class="wcmp-regi-12">
                                        <label for="reg_email">Email address <span class="required">*</span></label>
                                        <input type="email" class="form-control unicase-form-control" required="required" name="email" id="reg_email" value="">
                                    </div>
                                    <div class="wcmp-regi-12">
                                        <label for="reg_password">Password <span class="required">*</span></label>
                                        <input type="password" class="form-control unicase-form-control" required="required" name="password" id="reg_password">
                                    </div>
                                    <div style="left: -999em; position: absolute;"><label for="trap">Anti-spam</label><input type="text" name="email_2" id="trap" tabindex="-1"></div>
                                    <input type="hidden" id="woocommerce-register-nonce" name="woocommerce-register-nonce" value="93195e5463"><input type="hidden" name="_wp_http_referer" value="/dealsdot/vendor-registration/">																														<div class="clearboth"></div>
                                </div>

                                <input type="hidden" value="true" name="pending_vendor">
                                <div class="woocommerce-privacy-policy-text">
                                    <p>Your personal data will be used to support your experience throughout this website, to manage access to your account, and for other purposes described in our <a href="https://klbtheme.com/dealsdot/?page_id=3" class="woocommerce-privacy-policy-link" target="_blank">privacy policy</a>.</p>
                                </div>									<p class="woocomerce-FormRow form-row">
                                    <button type="submit" class="btn-upper btn btn-primary checkout-page-button" name="register">Register</button>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>