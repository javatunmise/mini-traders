@page
@model site.Pages.Sellers.RegistrationModel
@{
    ViewData["Title"] = "Registration";
}

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">Sellers</li>
        <li class="list-inline-item">Registration</li>
    </ol>
}

<div class="row custom-margin"></div>
<div class="row custom-margin"></div>


<div class="container">

    <div class="row">
        <div class="col-md-12">
            <div class="sign-in-page">
                <div class="row">
                    <div class="col-md-12 col-sm-12 sign-in">
                        <div class="wcmp_regi_main">
                            <form class="register-form outer-top-xs register" role="form" method="post" enctype="multipart/form-data">
                                <h4>Seller Registration Form</h4>

                                <div asp-validation-summary="All" class="text-danger"></div>
                                <br />

                                <div class="wcmp_regi_form_box">

                                    <div class="wcmp-regi-12">
                                        <label asp-for="Input.StoreName">Business name <span class="required">*</span></label>
                                        <input class="form-control unicase-form-control " asp-for="Input.StoreName">
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label asp-for="Input.StoreDescription">About your business <span class="required">*</span></label>
                                        <textarea class="form-control unicase-form-control" asp-for="Input.StoreDescription"></textarea>
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label asp-for="Input.CampusId">Campus <span class="required">*</span></label>
                                        <select class="form-control unicase-form-control" asp-for="Input.CampusId" asp-items="Model.Campuses" onchange="locationChanged()">
                                            <option value="">-- Select Campus --</option>
                                        </select>

                                        <img src="~/images/spinner.jpg" style="height:48px; display: none" id="location-spinner" />
                                    </div>
                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label asp-for="Input.HostelId">Hostel <span class="required">*</span></label>
                                        <select class="form-control unicase-form-control" asp-for="Input.HostelId">
                                            <option value="0">Anywhere on campus</option>
                                        </select>
                                    </div>
                                    
                                    <br />
                                    <div class="form-group">
                                        <label asp-for="Input.ContactPhone">Phone number <span class="required">*</span></label>
                                        <input asp-for="Input.ContactPhone" class="form-control">
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label asp-for="DocUpload">Means of Identification (e.g. ID Card) <span class="required">*</span></label>
                                        <input class="form-control" asp-for="DocUpload">

                                    </div>

                                    @*<br />*@

                                    @*<div id="bio-data-form" class="hide">
            <div class="wcmp-regi-12">
                <label for="reg_username">First Name <span class="required">*</span></label>
                <input type="text" class="form-control" asp-for="Input.BioData.FirstName" placeholder="0029931">
            </div>
            <br />
            <div class="wcmp-regi-12">
                <label for="reg_username">Last Name <span class="required">*</span></label>
                <input type="text" class="form-control" asp-for="Input.BioData.LastName" placeholder="0029931">
            </div>
        </div>*@


                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label asp-for="Input.ReferrerCode">Referral Code <span class="required">*</span></label>
                                        <input class="form-control" asp-for="Input.ReferrerCode" placeholder="893SK3JE">
                                    </div>


                                </div>

                                <br />
                                <div>
                                    <input type="checkbox" onchange="chkBoxClicked()" name="t-box" id="t-box">
                                    <label for="t-box">I have read the <a href="~/pages/terms-and-condition">terms & conditions</a>.</label>
                                </div>
                                <br />

                                <p>
                                    <button type="submit" class="btn-upper btn btn-primary checkout-page-button" name="register" id="register_button" disabled>Register</button>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div> 


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        function chkBoxClicked() {
            var chkbox = document.getElementById('t-box');

            enableRegisterButton(chkbox.checked);
        }

        function enableRegisterButton(agreementIsRead) {
            var submitButton = document.getElementById('register_button');
            if (agreementIsRead) {
                submitButton.removeAttribute("disabled");
                return;
            }

            submitButton.setAttribute("disabled", "disabled");
        }

        function showOrHideBioData() {
            var noStudentId = document.getElementById('chk-biodata').checked;
            if (noStudentId) {
                $('#bio-data-form').removeClass('hide');
            }
            else {
                $('#bio-data-form').addClass('hide');
            }
        }

        function locationChanged() {
            showHideSpinner(true);
            var id = document.getElementById('Input_CampusId').value;

            fetch('/api/data/sublocations/' + id)
                .then(response => response.json())
                .then(data => loadSelect(data))
                .catch(function () {
                    showHideSpinner(false);
                });
        }

        function loadSelect(data) {
            var elem = $('#Input_HostelId');
            elem.empty();
            elem.append($("<option />").val('0').text('Anywhere on campus'));
            $.each(data, function (i, item) {
                elem.append($("<option />").val(item.id).text(item.name));
            });

            showHideSpinner(false);
        }

        function showHideSpinner(show) {
            if (show) {
                $('#location-spinner').show();
            }
            else {
                $('#location-spinner').hide();
            }
        }

    </script>
}
