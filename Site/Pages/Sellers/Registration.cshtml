@page
@model site.Pages.Sellers.RegistrationModel
@{
    ViewData["Title"] = "Registration";
}

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">Sellers</li>
        <li class="list-inline-item">Registration</li>
    </ol>
}

<div class="row custom-margin"></div>
<div class="row custom-margin"></div>


<div class="container">

    <div class="row">
        <div class="col-md-12">
            <div class="sign-in-page">
                <div class="row">
                    <div class="col-md-12 col-sm-12 sign-in">
                        <div class="wcmp_regi_main">
                            <form class="register-form outer-top-xs register" role="form" method="post" enctype="multipart/form-data">
                                <h4>Seller Registration Form</h4>

                                <div asp-validation-summary="All" class="text-danger"></div>
                                <br />

                                <div class="wcmp_regi_form_box">

                                    <div class="wcmp-regi-12">
                                        <label for="reg_username">Store Name <span class="required">*</span></label>
                                        <input type="text" class="form-control unicase-form-control " name="username" id="reg_username" value="" required="required">
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label for="reg_email">Campus <span class="required">*</span></label>
                                        <select class="form-control unicase-form-control">
                                            <option>Unilag</option>
                                        </select>
                                    </div>
                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label for="reg_email">Hostel <span class="required">*</span></label>
                                        <select class="form-control unicase-form-control">
                                            <option>Moremi</option>
                                        </select>
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label for="reg_username">Referral Code <span class="required">*</span></label>
                                        <input type="text" class="form-control unicase-form-control " name="username" id="referral_code" value="" placeholder="893SK3JE">
                                    </div>


                                </div>

                                <br />
                                <div>
                                    <input type="checkbox" onchange="chkBoxClicked()" name="t-box" id="t-box">
                                    <label for="t-box">I have read the <a href="~/pages/terms-and-condition">terms & conditions</a>.</label>
                                </div>
                                <br />

                                <p>
                                    <button type="submit" class="btn-upper btn btn-primary checkout-page-button" name="register" id="register_button">Register</button>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        function chkBoxClicked() {
            var chkbox = document.getElementById('t-box');

            enableRegisterButton(chkbox.checked);
        }

        function enableRegisterButton(agreementIsRead) {
            var submitButton = document.getElementById('register_button');
            if (agreementIsRead) {
                submitButton.removeAttribute("disabled");
                return;
            }

            submitButton.setAttribute("disabled", "disabled");
        }
    </script>
}
