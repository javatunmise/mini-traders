@page
@model site.Pages.Admin.SitePages.AddPageModel
@{
    ViewData["Title"] = "AddPage";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Add New Page</h3>

<div>
    <form method="post" enctype="multipart/form-data">

        <div asp-validation-summary="All" class="text-danger"></div>
       
        <div class="form-group">
            <label>Page title</label>
            <input asp-for="Input.Title" class="form-control" />
        </div>

        <div class="form-group">
            <label>Upload page content</label>
            <input asp-for="Input.FileUpload" class="form-control" accept=".txt" />
        </div>

        <p>
            <button type="submit" class="btn btn-primary">Save</button>
        </p>

    </form>
</div>
