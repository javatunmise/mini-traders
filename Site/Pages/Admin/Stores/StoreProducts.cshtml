@page "/Admin/Stores/StoreProducts/{id}"
@model site.Pages.Admin.Stores.StoreProductsModel
@{
    ViewData["Title"] = "Site Information";
    ViewData["Logo"] = Model.CurrentStore?.LogoPath;
    Layout = "~/Pages/Shared/_LayoutAdminStore.cshtml";
    Func<int, string> GetEditProductUrl = productId => $"/Admin/Stores/EditProduct/{productId}";
    Func<int, string> GetViewProductUrl = productId => $"/products/{productId}-details";
    var selectedValue = Model.SearchQuery.FilterByServices ? "Services" : "Products";
    var filterOptions = new SelectList(new[] { "Products", "Services" }, selectedValue);
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Admin">Admin</a></li>
        <li class="breadcrumb-item"><a href="/Admin/Stores">Stores</a></li>
        <li class="breadcrumb-item">Store Products</li>
    </ol>
}

<h3 class="page-title-notpadded">Store Products (@Model.CurrentStore.StoreName)</h3>

<hr />

<div class="store-filter" style="border-bottom: solid 1px #ddd">

    <form class="form-inline">
        <label class="sr-only" for="inlineFormInputName2">Merchandize</label>
        <select name="filter" class="form-control mb-2 mr-sm-2" asp-items="filterOptions">
        </select>

        <button type="submit" class="btn btn-primary mb-2">Search</button>
    </form>
</div>
<br />

@if (Model.Products.Any())
{

    <table class="table table-striped product-desktop-view">
        <thead>
            <tr>
                <th style="width:120px"></th>
                <th>Details</th>
                <th>Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>
                        <a href="@PathUtil.GetProductPath(product)">
                            <img src="@Url.Content("~/" + product.ImageUrl)" style="height:100px; width:100px" class="img-fluid" alt="...">
                        </a>
                    </td>
                    <td>
                        <h4 class="mt-0 mb-1">@product.Name</h4>
                        @product.ProductDetails
                    </td>
                    <td>
                        Price: @product.Price.ToString("N2")
                        <br />
                        Old Price: @product.OldPrice.ToString("N2")
                    </td>
                    <td>@product.Status</td>
                    <td>
                        <a href="@GetViewProductUrl(product.Id)" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i> View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    @*<hr />

        <nav aria-label="Page navigation example" style="float: right;">
