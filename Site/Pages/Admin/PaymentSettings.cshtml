@page
@model site.Pages.Admin.PaymentSettingsModel
@{
    ViewData["Title"] = "Site Payment Settings";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Site Settings - Payment</h3>

<div>
    <a href="/Admin">General Settings</a> |
    <a href="/Admin/PaymentSettings">Payment Settings</a>
</div>

<hr />

@if (Model.Success)
{
    <div class="alert alert-success">
        Record saved!
    </div>
}

<form method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.SignonFee">Vendor Signon Fee <span class="required">*</span></label>
        <input class="form-control" asp-for="Input.SignonFee">
    </div>

    <br />
    <div class="form-group">
        <label asp-for="Input.WithdrawalCharge">Withdrawal Charge/Fee <span class="required">*</span></label>
        <input asp-for="Input.WithdrawalCharge" class="form-control">
    </div>

    <button type="submit" class="btn btn-primary">Save</button>

</form>

<br />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}