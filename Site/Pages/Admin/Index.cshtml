@page
@model site.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Site Information";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Site Settings</h3>

<form method="post">
    <div class="form-group">
        <label asp-for="Input.AboutUsIntro">About the site</label>
        <textarea class="form-control" asp-for="Input.AboutUsIntro"></textarea>
    </div>

    <br />
    <div class="form-group">
        <label asp-for="Input.PhoneNumber">Contact Phone Number <span class="required">*</span></label>
        <input class="form-control" asp-for="Input.PhoneNumber">
    </div>

    <br />
    <div class="form-group">
        <label asp-for="Input.Email">Contact Email <span class="required">*</span></label>
        <input asp-for="Input.Email" class="form-control">
    </div>


    <div class="form-group">
        <label asp-for="Input.Address">Address <span class="required">*</span></label>
        <input asp-for="Input.Address" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Input.WorkingHours">Working Hours <span class="required">*</span></label>
        <input asp-for="Input.Email" class="form-control">
    </div>


    <div class="form-group">
        <label asp-for="Input.FacebookUrl">Facebook Page Url <span class="required">*</span></label>
        <input asp-for="Input.FacebookUrl" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Input.TwitterUrl">Twitter Page Url <span class="required">*</span></label>
        <input asp-for="Input.TwitterUrl" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Input.InstagramUrl">Instagram Page Url <span class="required">*</span></label>
        <input asp-for="Input.InstagramUrl" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Input.LinkedInUrl">LinkedIn Page Url <span class="required">*</span></label>
        <input asp-for="Input.LinkedInUrl" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Input.YoutubeUrl">Youtube Page Url <span class="required">*</span></label>
        <input asp-for="Input.YoutubeUrl" class="form-control">
    </div>

    <div class="form-group form-check">
        <input asp-for="Input.IsGoogleAnalyticsEnabled" />
        <label asp-for="Input.IsGoogleAnalyticsEnabled">Track the site usage using Google Analytics</label>
    </div>

    <div class="form-group">
        <label asp-for="Input.GoogleAnalyticsScript">Paste Google Script below</label>
        <textarea class="form-control" asp-for="Input.GoogleAnalyticsScript"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>

</form>

<br />

@*<form method="post" asp-page-handler="OnPostVendorLogoAsync">
        <button type="submit" class="btn btn-primary">Save</button>

    </form>*@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
