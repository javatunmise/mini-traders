@page "{id}"
@model site.Pages.Admin.Categories.DeleteHostelModel
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this category: <b>@(Model.CurrentRecord?.Name)</b></h4>

    <form method="post">
        <a href="/Admin/Locations/Hostels/@Model.CurrentRecord?.Id" class="btn btn-secondary">No! It was a mistake</a>
        <button type="submit" class="btn btn-danger">Yes am sure</button>
    </form>
</div>
