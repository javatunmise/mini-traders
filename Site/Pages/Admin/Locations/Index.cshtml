@page
@model site.Pages.Admin.Locations.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
    var rowCount = 0;
}


@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Campuses</h3>

<table class="table table-striped table-bordered ">
    <thead>
        <tr>
            <th></th>
            <th>Campus</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var campus in Model.Campuses)
        {
        <tr>
            <td>@(++rowCount)</td>
            <td>@campus.Name</td>
            <td>
                <a href="/Admin/Locations/Hostels/@campus.Id">Hostels</a> |
                <a href="/Admin/Locations/EditCampus/@campus.Id">Edit</a> |
                <a href="/Admin/Locations/DeleteCampus/@campus.Id">Delete</a>
            </td>

        </tr>
        }
    </tbody>
</table>

<div class="alert alert-info">
    <h4>Add Campus</h4>

    <form method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label>Campus name:</label>
            <input asp-for="Input.Name" class="form-control" />
        </div>

        <p>
            <button type="submit" class="btn btn-primary">Add</button>
        </p>

    </form>
</div>