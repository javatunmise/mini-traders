@page "{id}"
@model site.Pages.Admin.Categories.DeleteCampusModel
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

@if (Model.HasHostels)
{
<div class="alert alert-danger">
    You cannot campus '<b>@(Model.CurrentRecord?.Name)</b>'. It has hostels attached.
    
</div>
}
else
{
<div class="alert alert-danger">
    <h4>Are you sure you want to delete this campus: <b>@(Model.CurrentRecord?.Name)</b></h4>

    <form method="post">
        <a href="/Admin/Locations" class="btn btn-secondary">No! It was a mistake</a>
        <button type="submit" class="btn btn-danger">Yes am sure</button>
    </form>
</div>
}