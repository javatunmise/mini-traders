@page "{id}"
@model site.Pages.Admin.Banners.EditModel
@{
    ViewData["Title"] = "Edit Carousel";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<form method="post" enctype="multipart/form-data" name="editform">
    <div class="form-group">
        <img src="@Url.Content("~/" + Model.ImagePath)" />

        <input type="hidden" name="handler" id="pageHandler" />
    </div>

    <div class="form-group">
        <label>Position on page: </label>
        <label>@Model.Input.EntityId</label>
    </div>

    <div class="form-group">
        <label asp-for="Input.ImageUpload">Upload another image</label>
        <input asp-for="Input.ImageUpload" />
    </div>

    <div class="form-group">
        <label asp-for="Input.Link">Link when the image is clicked</label>
        <input asp-for="Input.Link" class="form-control" />
    </div>

    <p>
        <button type="submit" class="btn-md bg-primary btn"> Save </button>
        <button type="submit" class="btn-md btn btn-danger float-right" onclick="btnClicked(event)"> Delete </button>
    </p>

</form>



@section Scripts{ 
    <script type="text/javascript">
        function btnClicked(e) {
            e.preventDefault();
            document.getElementById('pageHandler').value = 'ondelete';
            document.forms["editform"].submit();
        }
    </script>
}