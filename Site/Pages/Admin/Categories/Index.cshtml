@page
@model site.Pages.Admin.Categories.IndexModel
@{
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
    var rowCount = 0;
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Categories</h3>


<table class="table table-striped table-bordered ">
    <thead>
        <tr>
            <th></th>
            <th>Category</th>
            <th>Sub-categories</th>
            <th>Icon/Image</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@(++rowCount)</td>
                <td>@category.Name</td>
                <td>@category.ChildrenCount <a href="/Admin/Categories/Subcategories/@category.Id">(view)</a></td>
                <td><img src="@Url.Content("~/" + category.IconImagePath)" style="width:60px; height:60px" /></td>
                <td>
                    <a href="/Admin/Categories/Edit/@category.Id">Edit</a> |
                    <a href="/Admin/Categories/Delete/@category.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>

<div class="alert alert-info">
    <h4>Add Category</h4>

    <form method="post" enctype="multipart/form-data">

        <div asp-validation-summary="All"></div>

        <div class="form-group">
            <label>Category Name</label>
            <input asp-for="Input.CategoryName" class="form-control" />
        </div>
        <div class="form-group">
            <label>Icon Image (Preferred dimension is 48x48):</label>
            <input asp-for="Input.IconImage" class="form-control" />
        </div>

        <p>
            <button type="submit" class="btn btn-primary">Submit</button>
        </p>
    </form>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}

