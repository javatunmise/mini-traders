@page "{id}"
@model site.Pages.Admin.Categories.SubcategoriesModel
@{
    ViewData["Title"] = "Subcategories";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
    var rowCount = 0;
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Subcategories (@Model.CurrentCategory.Name)</h3>

<table class="table table-striped table-bordered ">
    <thead>
        <tr>
            <th></th>
            <th>Category</th>
            <th>Sub-categories</th>
            <th>Icon/Image</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@(++rowCount)</td>
                <td>@category.Name</td>
                <td>
                    @(category.ChildrenCount > 0 ? category.ChildrenCount.ToString() : "")
                    <a href="/Admin/Categories/Subcategories/@category.Id">@(category.ChildrenCount > 0 ? "(view)" : "Add subcategories")</a>
                </td>
                <td><img src="@Url.Content("~/" + category.IconImagePath)" style="width:60px; height:60px" /></td>
                <td>
                    <a href="/Admin/Categories/Edit/@category.Id">Edit</a> |
                    <a href="/Admin/Categories/Delete/@category.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>

@if (Model.CanAddSubcategory)
{
    <div class="alert alert-info">
        <h4>Add Category</h4>

        <form method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All"></div>

            <div class="form-group">
                <label>Category Name</label>
                <input asp-for="Input.CategoryName" class="form-control" />
            </div>
            <div class="form-group">
                <input asp-for="Input.IconImage" class="form-control" />
            </div>

            <p>
                <button type="submit" class="btn btn-primary">Submit</button>
            </p>
        </form>
    </div>
}



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}

