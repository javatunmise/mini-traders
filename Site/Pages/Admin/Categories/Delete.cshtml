@page "{id}"
@model site.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

@if (Model.Dependencies.Any())
{
<div class="alert alert-danger">
    You cannot delete '<b>@(Model.CurrentCategory?.Name)</b>' category, it has the following dependencies:

    <ul>
        @foreach (var kv in Model.Dependencies)
        {
            <li>@kv.Entity : @kv.TotalCount</li>
        }
    </ul>
</div>
}
else
{
<div class="alert alert-danger">
    <h4>Are you sure you want to delete this category: <b>@(Model.CurrentCategory?.Name)</b></h4>

    <form method="post">
        <a href="/Admin/Categories" class="btn btn-secondary">No! It was a mistake</a>
        <button type="submit" class="btn btn-danger">Yes am sure</button>
    </form>
</div>
}