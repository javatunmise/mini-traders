@page "{id}"
@model site.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
    var categories = new SelectList(Model.ParentCategories, "Id", "Name", Model.CurrentCategory?.Id);
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Edit Category (@Model.CurrentCategory.Name)</h3>

<form method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All"></div>

    <div class="form-group">
        <label>Category Name</label>
        <input asp-for="Input.CategoryName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Parent Category</label>
        <select asp-for="Input.ParentId" class="form-control" asp-items="categories">
            <option>--Select--</option>
        </select>
    </div>
    <div class="form-group">
        <input asp-for="Input.IconImage" class="form-control" />
    </div>

    <p>
        <button type="submit" class="btn btn-primary">Submit</button>
    </p>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}