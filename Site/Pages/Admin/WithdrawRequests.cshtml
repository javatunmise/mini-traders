@page
@model site.Pages.Admin.WithdrawRequestsModel
@{
    ViewData["Title"] = "Withdrawal Requests";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";

    var enums = Enum.GetNames(typeof(global::Shared.Entities.WithdrawRequestStatuses))
        .Select(e => new { k = e, v = e });
    var statuses = new SelectList(enums.AsEnumerable(), "v", "k", Model.Status);
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
    </ol>
}

<h3 class="page-title-notpadded">Withdrawal Requests</h3>
<hr />

<div>
    <form method="get" class="form-inline">
        Filter by status:&nbsp; <select class="form-control" asp-items="statuses" onchange="this.form.submit()" asp-for="Status"></select>
    </form>
</div>

<br />
<table class="table table-striped table-bordered @(Model.Requests.Any() ? "visible": "hide")">
    <thead>
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Amount</th>
            <th>Charge</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.Requests)
    {
        <tr>
            <td>@request.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>
            <td>@request.SiteUser.FullName</td>
            <td>@request.Amount.ToString("N2")</td>
            <td>@request.Charge.ToString("N2")</td>
            <td>
                <ul style="list-style-type: square; margin-left: 15px">
                    @{
                        var historyCount = 0;
                        foreach (var history in request.WorkflowHistories.OrderByDescending(e => e.CreatedOn))
                        {
                            if (historyCount > 0)
                            {
                                <li>@($"{history.CreatedOn:dd-MMM-yyyy hh:mm tt} {history.Status}")</li>
                            }
                            else
                            {
                                <li><b>@($"{history.CreatedOn:dd-MMM-yyyy hh:mm tt} {history.Status}")</b></li>
                                }

                                historyCount++;
                            }
                        }
                </ul>
            </td>
            <td>
                <a href="/Admin/UpdateWithdrawStatus/@request.Id">Update Status</a>
            </td>
        </tr>
        }
    </tbody>
</table>

<div class="alert alert-secondary @(Model.Requests.Any() ? "hide": "visible")">
    No records
</div>