@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}
<!-- Breadcrumb Area -->
    <section class="breadcrumb-area" style="padding: 15px 0">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="breadcrumb-box text-center">
                        <ul class="list-unstyled list-inline">
                            <li class="list-inline-item"><a href="~/">Home</a></li>
                            <li class="list-inline-item"><span>||</span> Register</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
<!-- End Breadcrumb Area -->
<!-- Register -->
<section class="register">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h5>Create Your Account</h5>
                    <hr />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Input.Email"></label>
                            <input asp-for="Input.Email" class="form-control cm-form-control" />
                            @*<span asp-validation-for="Input.Email" class="text-danger"></span>*@
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.Password"></label>
                            <input asp-for="Input.Password" class="form-control cm-form-control" />
                            @*<span asp-validation-for="Input.Password" class="text-danger"></span>*@
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.ConfirmPassword"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control cm-form-control" />
                            @*<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>*@
                        </div>

                        <div class="col-md-7">
                            <div>
                                <input type="checkbox" name="t-box" id="t-box" onchange="$('#register-submit').toggleClass('hide')">
                                <label for="t-box">I have read the <a href="~/pages/terms-and-condition">terms & conditions</a>.</label>
                            </div>
                            @*<div>
            <input type="checkbox" name="c-box" id="c-box">
            <label for="c-box">Subscribe for newsletter</label>
        </div>*@
                        </div>
                        <div class="col-md-5 text-right">
                            <button type="submit" name="button" class="hide" id="register-submit">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<!-- End Register -->


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
