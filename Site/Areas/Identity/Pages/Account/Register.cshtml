@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<!-- Breadcrumb Area -->
@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">Register</li>
    </ol>
}


<!-- Register -->
<div class="row custom-margin"></div>
<div class="row custom-margin"></div>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="sign-in-page">
                <div class="row">
                    <div class="col-md-12 col-sm-12 sign-in">
                        <div class="main">
                            <form class="register-form outer-top-xs register" role="form" id="account" method="post" enctype="multipart/form-data">
                                <h4>Create Your Account</h4>

                                <div asp-validation-summary="All" class="text-danger"></div>
                                <br />
                                <div class="wcmp_regi_form_box">

                                    @*<div class="wcmp-regi-12">
                                            <label for="reg_username">Username <span class="required">*</span></label>
                                            <input type="text" class="form-control unicase-form-control " name="username" id="reg_username" value="" required="required">
                                        </div>*@
                                    <div class="wcmp-regi-12">
                                        <label for="reg_email">Email address <span class="required">*</span></label>
                                        <input asp-for="Input.Email" class="form-control unicase-form-control" required="required" id="reg_email">
                                    </div>

                                    <br />
                                    <div class="wcmp-regi-12">
                                        <label for="reg_password">Password <span class="required">*</span></label>
                                        <input asp-for="Input.Password" class="form-control unicase-form-control" id="reg_password">
                                    </div>
                                    <br />

                                    <div class="wcmp-regi-12">
                                        <label for="reg_password">Confirm Password <span class="required">*</span></label>
                                        <input asp-for="Input.ConfirmPassword" class="form-control unicase-form-control">
                                    </div>

                                </div>

                                <input type="hidden" value="true" name="pending_vendor">

                                <br />
                                <div>
                                    <input type="checkbox" onchange="chkBoxClicked()" name="t-box" id="t-box">
                                    <label for="t-box">I have read the <a href="~/pages/terms-and-condition">terms & conditions</a>.</label>
                                </div>
                                <br />

                                <p class="FormRow form-row">
                                    <button type="submit" class="btn-upper btn btn-primary checkout-page-button" name="register" id="register_button" disabled>Register</button>
                                </p>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- End Register -->


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        function chkBoxClicked() {
            var chkbox = document.getElementById('t-box');

            enableRegisterButton(chkbox.checked);
        }

        function enableRegisterButton(agreementIsRead) {
            var submitButton = document.getElementById('register_button');            
            if (agreementIsRead) {
                submitButton.removeAttribute("disabled");
                return;
            }

            submitButton.setAttribute("disabled", "disabled");
        }
    </script>
}
