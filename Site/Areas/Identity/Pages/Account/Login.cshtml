@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section BreadCrumbs {
    <ol class="breadcrumb">
        <li class="list-inline-item"><a href="/">Home</a></li>
        <li class="list-inline-item">Login</li>
    </ol>
}

<div class="row custom-margin"></div>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="sign-in-page">
                <div class="row">
                    <div class="col-md-12 col-sm-12 sign-in">
                        <div class="main">
                            <form class="register-form outer-top-xs register" role="form" id="account" method="post" enctype="multipart/form-data">
                                <h4>Login</h4>


                                <div class="form_box">

                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="12">
                                        <label for="reg_email">Email address <span class="required">*</span></label>
                                        <input asp-for="Input.Email" class="form-control unicase-form-control" id="reg_email">
                                    </div>

                                    <br />
                                    <div class="12">
                                        <label for="reg_password">Password <span class="required">*</span></label>
                                        <input asp-for="Input.Password" class="form-control unicase-form-control" id="reg_password">
                                    </div>
                                    <div style="left: -999em; position: absolute;">
                                        <label for="trap">Anti-spam</label>
                                        <input type="text" name="email_2" id="trap" tabindex="-1">
                                    </div>
                                    <input type="hidden" id="login-nonce" name="login-nonce" value="93195e5463">
                                </div>

                                <input type="hidden" value="true" name="pending_vendor">

                                <br />
                                <p></p>

                                <p class="FormRow form-row">
                                    <button type="submit" class="btn-upper btn btn-primary checkout-page-button" name="register">Login</button>
                                </p>

                                <div>
                                    <a id="register" asp-page="./Register">Register</a> &nbsp;|&nbsp;
                                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


